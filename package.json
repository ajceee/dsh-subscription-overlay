{
  "name": "@dsh-external/dsh-subscription-overlay",
  "version": "0.1.0",
  "description": "DSH subscription overlay: quota aggregation for claude/codex/opencode-go + commandcode probe + local burn ledger",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/build.mjs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "immer": "^10.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.1"
  }
}
